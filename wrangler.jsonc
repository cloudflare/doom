{
  "name": "agentic-doom",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "workers_dev": false,
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "directory": "./dist",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "route": {
        "pattern": "silentspacemarine.com",
        "custom_domain": true
      }
    },
    "staging": {
      "route": {
        "pattern": "dev.silentspacemarine.com",
        "custom_domain": true
      }
    }
  },
  // global and local development
  "durable_objects": {
    "bindings": [
      {
        "name": "router",
        "class_name": "Router"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["Router"]
    }
  ]
}
