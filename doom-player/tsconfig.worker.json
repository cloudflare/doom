{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "es2022",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"composite": true
	},
	"include": [
		"worker-configuration.d.ts",
		"src/index.ts",
		"src/preroll.ts",
		"src/cdp/**/*.ts",
		"src/bot/**/*.ts"
	]
}
